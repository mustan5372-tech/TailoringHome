# ==============================================================================
# Tailoring Home & Fabric Home - Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production')
VITE_APP_ENV=development
VITE_APP_NAME="Tailoring Home & Fabric Home"
VITE_APP_URL=http://localhost:5173

# Firebase Configuration
# Replace these with your actual Firebase project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Environment Partitioning (Keeps development test data isolated from production)
# Development collections will use prefix 'dev_' and storage folder 'dev_uploads'
VITE_FIRESTORE_COLLECTION_PREFIX=dev_
VITE_FIREBASE_STORAGE_FOLDER=dev_uploads

