# ==============================================================================
# Tailoring Home & Fabric Home - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your Firebase Web App credentials.
#
# IMPORTANT SECURITY GUIDELINES:
# - NEVER commit your local '.env' file to Git (verified in .gitignore).
# - NEVER place service account private keys or backend credentials in frontend code.
# - The variables below are public client-side web configuration keys only.
# ==============================================================================

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development
VITE_APP_NAME="Tailoring Home & Fabric Home"
VITE_APP_URL=http://localhost:5173

# ==============================================================================
# Firebase Web SDK Configuration
# Project: tailoringhome-3cd89
#
# How to obtain these values:
# 1. Visit the Firebase Console: https://console.firebase.google.com/project/tailoringhome-3cd89
# 2. Click the Settings Gear (⚙️) -> Project settings -> General tab.
# 3. Under "Your apps", select or register your Web App (</>).
# 4. Copy the credentials from the firebaseConfig object into your local .env file.
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tailoringhome-3cd89.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tailoringhome-3cd89
VITE_FIREBASE_STORAGE_BUCKET=tailoringhome-3cd89.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# Google Analytics 4 Configuration (gtag.js)
# Decoupled from Firebase configuration
# ==============================================================================
VITE_GA_MEASUREMENT_ID=G-WPDJ3V8XF6

# ==============================================================================
# Environment Partitioning
# Isolates development test data from production.
# ==============================================================================
VITE_FIRESTORE_COLLECTION_PREFIX=dev_
VITE_FIREBASE_STORAGE_FOLDER=dev_uploads
