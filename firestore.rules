rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SECURITY HELPER FUNCTIONS
    // =========================================================================

    // Verify user is authenticated with Firebase
    function isAuthenticated() {
      return request.auth != null;
    }

    // Retrieve the admin profile document
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // Check if user exists in the admin collection and is marked active
    function isActiveAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        getAdminDoc().active == true;
    }

    // Super Administrator: Highest privilege level
    function isSuperAdmin() {
      return isActiveAdmin() && (
        getAdminDoc().role == 'super_admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    // Tailoring Administrator: Authority over tailoring & school uniforms
    function isTailoringAdmin() {
      return isActiveAdmin() && (
        getAdminDoc().role == 'tailoring_admin' ||
        request.auth.token.role == 'tailoring_admin' ||
        isSuperAdmin()
      );
    }

    // Fabric Administrator: Authority over fabric catalogue and swatches
    function isFabricAdmin() {
      return isActiveAdmin() && (
        getAdminDoc().role == 'fabric_admin' ||
        request.auth.token.role == 'fabric_admin' ||
        isSuperAdmin()
      );
    }

    // Customer Enquiry Schema and Anti-Abuse Validator
    function isValidEnquiry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'phone', 'email', 'service', 'message', 'createdAt', 'status'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('service' in data) || (data.service is string && data.service.size() <= 80))
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    // =========================================================================
    // 1. TAILORING SERVICES (Bohra Wear, School Uniforms, Suiting)
    // =========================================================================
    match /tailoring_services/{itemId} {
      allow read: if true;
      allow write: if isTailoringAdmin();
    }
    match /dev_tailoring_services/{itemId} {
      allow read: if true;
      allow write: if isTailoringAdmin();
    }

    // =========================================================================
    // 2. FABRICS CATALOGUE (Silks, Cottons, Linens, Suiting Wools)
    // =========================================================================
    match /fabrics_catalogue/{fabricId} {
      allow read: if true;
      allow write: if isFabricAdmin();
    }
    match /dev_fabrics_catalogue/{fabricId} {
      allow read: if true;
      allow write: if isFabricAdmin();
    }

    // =========================================================================
    // 3. GALLERY SHOWCASE
    // =========================================================================
    match /gallery_showcase/{photoId} {
      allow read: if true;
      allow write: if isTailoringAdmin() || isFabricAdmin();
    }
    match /dev_gallery_showcase/{photoId} {
      allow read: if true;
      allow write: if isTailoringAdmin() || isFabricAdmin();
    }

    // =========================================================================
    // 4. SITE SETTINGS & BRAND METADATA
    // =========================================================================
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /dev_site_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 5. CUSTOMER ENQUIRIES (Public submission, Admin review)
    // =========================================================================
    match /customer_enquiries/{enquiryId} {
      allow create: if isValidEnquiry();
      allow read, update, delete: if isTailoringAdmin() || isFabricAdmin();
    }
    match /dev_customer_enquiries/{enquiryId} {
      allow create: if isValidEnquiry();
      allow read, update, delete: if isTailoringAdmin() || isFabricAdmin();
    }

    // =========================================================================
    // 6. ADMIN USER MANAGEMENT (/admins)
    // Prevents privilege escalation: only Super Admin can create or assign roles
    // =========================================================================
    match /admins/{adminId} {
      // Admins can read their own profile to verify their role; Super Admin reads all
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == adminId);
      // Only Super Admin can invite, modify, or deactivate administrators
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 7. USER PROFILES (/users)
    // =========================================================================
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users cannot elevate their own role or modify administrative flags
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin', 'permissions']);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 8. DEFAULT DENY
    // Block all unmapped collections and wildcard paths
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
